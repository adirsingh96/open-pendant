/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Mic power on at boot. IMU regulator needs extra settle time; probe the
 * LSM6DS3TR-C after boot (deferred-init in main).
 */
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	msm261d3526hicpm-c-en {
		regulator-boot-on;
	};

	lsm6ds3tr-c-en {
		regulator-always-on;
		startup-delay-us = <20000>;
	};

	buttons {
		compatible = "gpio-keys";
		/* Mouse microswitch: COM → GND, NO → D10 (P1.15). Internal pull-up. */
		user_btn: user_btn {
			gpios = <&xiao_d 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "USER";
		};
	};
};

/* WLY602030 LiPo: VBAT — 1 MΩ — P0.31 — 510 kΩ — P0.14.
 * P0.14 must stay LOW while a cell is attached or P0.31 can exceed 3.6 V.
 */
&gpio0 {
	bat-meas-en {
		gpio-hog;
		gpios = <14 0>;
		output-low;
		line-name = "bat-meas-en";
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
	};
};

dmic_dev: &pdm0 {
	status = "okay";
	/* Board DTS uses PCLK32M (HFINT). That clock is too jittery for STT. */
	clock-source = "PCLK32M_HFXO";
	queue-size = <8>;
};

&i2c0 {
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&lsm6ds3tr_c {
	zephyr,deferred-init;
};
